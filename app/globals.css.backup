@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap');

:root {
  --bg: #03040a;
  --bg-soft: #070912;
  --panel: #090c16;
  --panel-2: #0d1120;

  --white: #f7f7fb;
  --text: #e7e9f2;
  --muted: #9299ad;
  --muted-2: #697187;

  --purple: #8b3dff;
  --purple-light: #b66cff;
  --blue: #4d7cff;
  --cyan: #25d9ff;

  --border: rgba(255,255,255,0.11);
  --border-bright: rgba(139,61,255,0.45);

  --glow: rgba(139,61,255,0.25);
  --max-width: 1500px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Inter", sans-serif;
  font-size: 18px;
  line-height: 1.7;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

::selection {
  background: var(--purple);
  color: white;
}

/* =========================================================
   GLOBAL BACKGROUND
========================================================= */

.learning-page,
.chainlab-home {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 80% 10%,
      rgba(92, 45, 255, 0.18),
      transparent 30%
    ),
    radial-gradient(
      circle at 15% 45%,
      rgba(25, 100, 255, 0.08),
      transparent 30%
    ),
    linear-gradient(
      180deg,
      #02030a 0%,
      #050711 50%,
      #02030a 100%
    );
  position: relative;
}

.learning-page::before,
.chainlab-home::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(
      rgba(130,140,180,0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(130,140,180,0.035) 1px,
      transparent 1px
    );
  background-size: 70px 70px;
  mask-image: linear-gradient(
    to bottom,
    black,
    transparent 85%
  );
  z-index: 0;
}

.learning-page > *,
.chainlab-home > * {
  position: relative;
  z-index: 1;
}

/* =========================================================
   NAVIGATION
========================================================= */

.site-nav {
  width: 100%;
  min-height: 86px;
  padding: 0 5vw;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid var(--border);
  background: rgba(3,4,10,0.82);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-family: "Space Mono", monospace;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: white;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 36px;
}

.nav-links a,
.nav-action,
.nav-wallet {
  font-family: "Space Mono", monospace;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: 0.25s ease;
}

.nav-links a {
  color: #aeb5c8;
}

.nav-links a:hover {
  color: var(--purple-light);
}

.nav-action {
  padding: 11px 17px;
  border: 1px solid var(--border-bright);
  color: white;
  background: rgba(139,61,255,0.08);
}

.nav-action:hover {
  background: var(--purple);
  box-shadow: 0 0 30px var(--glow);
}

.nav-wallet {
  padding: 11px 18px;
  border: 1px solid rgba(37,217,255,0.45);
  color: var(--cyan);
}

/* =========================================================
   TYPOGRAPHY
========================================================= */

.eyebrow {
  margin: 0;
  color: var(--purple-light);
  font-family: "Space Mono", monospace;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.14em;
  line-height: 1.5;
  text-transform: uppercase;
}

h1,
h2,
h3 {
  margin-top: 0;
  color: var(--white);
  font-weight: 900;
  letter-spacing: -0.055em;
  line-height: 0.95;
}

p {
  margin-top: 0;
}

/* =========================================================
   LEARNING HERO
========================================================= */

.learning-hero {
  min-height: 680px;
  padding: 130px 7vw 120px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  border-bottom: 1px solid var(--border);

  background:
    radial-gradient(
      circle at 75% 45%,
      rgba(117,49,255,0.18),
      transparent 35%
    );
}

.learning-hero h1 {
  max-width: 1050px;
  margin: 30px 0 45px;
  font-size: clamp(70px, 10vw, 150px);
}

.learning-hero h1 span {
  color: var(--purple-light);
  text-shadow: 0 0 50px rgba(139,61,255,0.3);
}

.learning-intro {
  max-width: 760px;
  margin: 0;
  color: #b9c0d2;
  font-size: 23px;
  line-height: 1.65;
}

/* =========================================================
   LESSON SECTIONS
========================================================= */

.lesson-section {
  padding: 120px 7vw;
  display: grid;
  grid-template-columns: minmax(300px, 0.85fr) minmax(400px, 1.15fr);
  gap: 90px;
  border-bottom: 1px solid var(--border);
}

.lesson-header h2 {
  margin-top: 25px;
  font-size: clamp(45px, 5vw, 82px);
}

.lesson-content {
  max-width: 850px;
}

.lesson-content p {
  margin-bottom: 30px;
  color: #aeb6ca;
  font-size: 21px;
  line-height: 1.8;
}

/* =========================================================
   CONCEPTS
========================================================= */

.concept-section {
  padding: 120px 7vw;
  border-bottom: 1px solid var(--border);
}

.concept-grid {
  margin-top: 55px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--border);
  border-left: 1px solid var(--border);
}

.concept-card {
  min-height: 280px;
  padding: 36px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: linear-gradient(
    145deg,
    rgba(255,255,255,0.025),
    rgba(139,61,255,0.025)
  );
  transition: 0.3s ease;
}

.concept-card:hover {
  background: rgba(139,61,255,0.08);
  transform: translateY(-5px);
  box-shadow: inset 0 0 40px rgba(139,61,255,0.05);
}

.concept-card span,
.step > span {
  display: block;
  margin-bottom: 30px;
  color: var(--purple-light);
  font-family: "Space Mono", monospace;
  font-size: 14px;
  font-weight: 700;
}

.concept-card h3 {
  margin-bottom: 20px;
  font-size: 30px;
  letter-spacing: -0.03em;
}

.concept-card p {
  color: var(--muted);
  font-size: 17px;
  line-height: 1.7;
}

/* =========================================================
   STEPS
========================================================= */

.steps {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--border);
  border-left: 1px solid var(--border);
}

.step {
  min-height: 270px;
  padding: 38px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.step h3 {
  margin-bottom: 18px;
  font-size: 27px;
}

.step p {
  color: var(--muted);
  font-size: 17px;
  line-height: 1.7;
}

/* =========================================================
   SOLANA TRANSACTION FLOW
========================================================= */

.flow-section {
  padding: 130px 7vw;
  border-bottom: 1px solid var(--border);

  background:
    radial-gradient(
      circle at 85% 45%,
      rgba(116,61,255,0.14),
      transparent 32%
    );
}

.flow-section > .eyebrow {
  margin-bottom: 25px;
}

.flow-section h2 {
  max-width: 1000px;
  margin-bottom: 75px;
  font-size: clamp(60px, 8vw, 125px);
}

.flow-section h2 span {
  color: var(--purple-light);
}

.flow-grid {
  width: 100%;

  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    80px
    minmax(0, 1fr)
    80px
    minmax(0, 1fr)
    80px
    minmax(0, 1fr);

  align-items: stretch;

  border-top: 1px solid var(--border);
  border-left: 1px solid var(--border);
}

.flow-item {
  min-height: 250px;
  padding: 35px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);

  background: rgba(255,255,255,0.025);

  display: flex;
  flex-direction: column;
  justify-content: center;

  transition: 0.3s ease;
}

.flow-item:hover {
  background: rgba(139,61,255,0.08);
  transform: translateY(-4px);
}

.flow-item span {
  margin-bottom: 22px;
  color: var(--purple-light);
  font-family: "Space Mono", monospace;
  font-size: 14px;
  font-weight: 700;
}

.flow-item strong {
  margin-bottom: 15px;
  color: white;
  font-size: 27px;
  letter-spacing: -0.02em;
}

.flow-item p {
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.6;
}

.flow-arrow {
  min-height: 250px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);

  color: var(--purple-light);
  font-size: 34px;
}

.flow-arrow::after {
  content: "→";
}

/* =========================================================
   LEARNING CARDS
========================================================= */

.learning-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.learning-card {
  min-height: 300px;
  padding: 30px;
  border: 1px solid var(--border);
  background: var(--panel);
  transition: 0.3s ease;
}

.learning-card:hover {
  border-color: var(--border-bright);
  transform: translateY(-6px);
  box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

/* =========================================================
   BUTTONS
========================================================= */

.primary-button,
.outline-button,
.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 50px;
  padding: 0 24px;

  font-family: "Space Mono", monospace;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  transition: 0.25s ease;
}

.primary-button {
  color: white;
  background: linear-gradient(
    100deg,
    #7736ff,
    #a04cff
  );
  border: 1px solid var(--purple-light);
  box-shadow: 0 0 30px rgba(139,61,255,0.18);
}

.primary-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 0 45px rgba(139,61,255,0.4);
}

.outline-button {
  color: var(--purple-light);
  border: 1px solid var(--border-bright);
}

.outline-button:hover {
  color: white;
  background: rgba(139,61,255,0.12);
}

.text-button {
  color: var(--cyan);
  padding-left: 0;
  padding-right: 0;
}

/* =========================================================
   NEXT SECTION
========================================================= */

.next-section {
  min-height: 620px;
  padding: 130px 7vw;

  display: flex;
  flex-direction: column;
  justify-content: center;

  border-bottom: 1px solid var(--border);

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(139,61,255,0.12),
      transparent 40%
    );
}

.next-section h2 {
  margin: 25px 0 50px;
  font-size: clamp(70px, 10vw, 150px);
}

.next-section h2 span {
  color: var(--purple-light);
}

/* =========================================================
   FOOTER
========================================================= */

.site-footer {
  padding: 70px 7vw;

  display: flex;
  justify-content: space-between;
  gap: 50px;

  border-top: 1px solid var(--border);
  background: #020308;
}

.footer-brand strong {
  font-family: "Space Mono", monospace;
  color: white;
}

.footer-brand p,
.site-footer p {
  color: var(--muted);
  font-size: 14px;
}

.footer-links {
  display: flex;
  gap: 40px;
}

.footer-links a {
  color: var(--muted);
  font-size: 14px;
}

.footer-links a:hover {
  color: var(--purple-light);
}

.footer-bottom {
  color: var(--muted-2);
  font-family: "Space Mono", monospace;
  font-size: 11px;
}

/* =========================================================
   HOMEPAGE
========================================================= */

.homepage-grid {
  width: 100%;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.2fr 1fr 0.85fr;
}

.homepage-column {
  min-width: 0;
  border-right: 1px solid var(--border);
}

.homepage-left {
  padding: 40px;
}

.homepage-middle,
.homepage-right {
  padding: 30px;
}

.hero {
  min-height: 760px;
  padding: 90px 6vw;
  position: relative;
  overflow: hidden;
}

.hero-content {
  position: relative;
  z-index: 3;
  max-width: 850px;
}

.hero h1 {
  margin: 30px 0;
  font-size: clamp(70px, 9vw, 140px);
}

.hero-description {
  max-width: 650px;
  color: var(--muted);
  font-size: 20px;
}

.hero-actions {
  margin-top: 40px;
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.hero-visual {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(
      rgba(100,100,180,0.05) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(100,100,180,0.05) 1px,
      transparent 1px
    );
  background-size: 60px 60px;
}

.hero-glow {
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.25;
}

.hero-glow-one {
  right: 5%;
  top: 15%;
  background: var(--purple);
}

.hero-glow-two {
  right: 30%;
  bottom: 0;
  background: var(--blue);
}

/* =========================================================
   HOMEPAGE PANELS
========================================================= */

.hero-panel,
.learning-panel,
.academy-panel,
.solana-panel,
.security-panel,
.case-study-panel,
.community-panel,
.stats-panel,
.start-panel,
.meme-token-panel,
.tokenomics {
  border: 1px solid var(--border);
  background: rgba(8,11,20,0.72);
  backdrop-filter: blur(12px);
}

.panel-heading {
  padding: 20px;
  border-bottom: 1px solid var(--border);
  color: white;
  font-family: "Space Mono", monospace;
  font-size: 12px;
  letter-spacing: 0.08em;
}

.panel-number {
  color: var(--purple-light);
  font-family: "Space Mono", monospace;
  font-size: 12px;
}

.stat-item {
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.stat-item strong {
  display: block;
  color: white;
  font-size: 25px;
}

.stat-icon,
.card-icon,
.journey-icon {
  color: var(--purple-light);
}

/* =========================================================
   BLOCKCHAIN / SOLANA VISUALS
========================================================= */

.blockchain-visual,
.solana-visual,
.bm-visual,
.security-visual,
.hero-core {
  position: relative;
  min-height: 350px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.blockchain-center,
.solana-symbol,
.bm-coin,
.shield {
  position: relative;
  z-index: 3;
}

.solana-symbol {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: white;
  font-size: 60px;
  font-weight: 900;
  background:
    radial-gradient(
      circle,
      rgba(139,61,255,0.5),
      rgba(30,80,255,0.08) 60%,
      transparent 70%
    );
  box-shadow:
    0 0 50px rgba(139,61,255,0.35),
    inset 0 0 50px rgba(37,217,255,0.08);
}

.solana-orbit,
.orbital-ring {
  position: absolute;
  border: 1px solid rgba(139,61,255,0.35);
  border-radius: 50%;
}

.solana-orbit {
  width: 320px;
  height: 180px;
  transform: rotate(-25deg);
}

.orbital-ring-one {
  width: 300px;
  height: 300px;
}

.orbital-ring-two {
  width: 390px;
  height: 200px;
  transform: rotate(35deg);
}

.orbital-ring-three {
  width: 450px;
  height: 150px;
  transform: rotate(-45deg);
}

/* =========================================================
   SECURITY
========================================================= */

.security-section {
  padding: 80px 7vw;
}

.security-list {
  display: grid;
  gap: 15px;
}

.security-content {
  color: var(--muted);
}

.security-panel {
  padding: 35px;
}

.shield {
  width: 180px;
  height: 210px;
  background: linear-gradient(
    145deg,
    rgba(139,61,255,0.35),
    rgba(37,217,255,0.08)
  );
  clip-path: polygon(
    50% 0%,
    90% 15%,
    85% 65%,
    50% 100%,
    15% 65%,
    10% 15%
  );
  box-shadow: 0 0 50px rgba(139,61,255,0.4);
}

/* =========================================================
   BM ALPHA
========================================================= */

.bm-coin {
  width: 190px;
  height: 190px;
  border-radius: 50%;

  display: grid;
  place-items: center;

  color: white;
  font-size: 42px;
  font-weight: 900;

  border: 2px solid var(--purple-light);

  background:
    radial-gradient(
      circle at 35% 30%,
      #7e55ff,
      #1b1535 55%,
      #05050b
    );

  box-shadow:
    0 0 40px rgba(139,61,255,0.45),
    inset 0 0 30px rgba(255,255,255,0.08);
}

.coin-glow {
  position: absolute;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: var(--purple);
  filter: blur(80px);
  opacity: 0.18;
}

.meme-info {
  color: var(--muted);
}

.case-list {
  display: grid;
  gap: 12px;
}

/* =========================================================
   TOKENOMICS
========================================================= */

.token-chart {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.chart-ring {
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background:
    conic-gradient(
      var(--purple) 0 40%,
      var(--blue) 40% 65%,
      var(--cyan) 65% 80%,
      #343b55 80% 100%
    );
  display: grid;
  place-items: center;
}

.chart-ring::after {
  content: "";
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: var(--bg);
}

.token-legend {
  display: grid;
  gap: 10px;
  padding: 25px;
}

.tokenomics {
  padding: 30px;
}

/* =========================================================
   JOURNEY
========================================================= */

.journey-panel {
  padding: 50px;
}

.journey-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.journey-step {
  padding: 25px;
  border: 1px solid var(--border);
}

.journey-label {
  color: white;
  font-weight: 800;
}

.journey-intro {
  color: var(--muted);
}

.journey-arrow {
  color: var(--purple-light);
}

/* =========================================================
   MISC VISUAL ELEMENTS
========================================================= */

.network-node {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 20px var(--cyan);
}

.network-line {
  position: absolute;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    var(--purple),
    transparent
  );
}

.hood {
  position: relative;
}

.hood-face {
  background: #090b12;
}

.scroll-arrow {
  color: var(--purple-light);
}

.hero-cube {
  position: absolute;
  width: 100px;
  height: 100px;
  border: 1px solid rgba(139,61,255,0.4);
  transform: rotate(45deg);
}

.cube-one {
  top: 20%;
  right: 20%;
}

.cube-two {
  top: 50%;
  right: 10%;
}

.cube-three {
  bottom: 10%;
  right: 30%;
}

.hero-floor {
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    var(--purple),
    transparent
  );
}

.hero-scroll {
  color: var(--muted);
  font-family: "Space Mono", monospace;
  font-size: 11px;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {
  .nav-links {
    gap: 18px;
  }

  .lesson-section {
    grid-template-columns: 1fr;
  }

  .concept-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .learning-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .homepage-grid {
    grid-template-columns: 1fr;
  }

  .homepage-column {
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .journey-track {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 800px) {
  body {
    font-size: 17px;
  }

  .site-nav {
    min-height: 72px;
    padding: 0 20px;
  }

  .nav-links {
    display: none;
  }

  .nav-action {
    font-size: 10px;
  }

  .learning-hero {
    min-height: 600px;
    padding: 90px 24px;
  }

  .learning-hero h1 {
    font-size: clamp(55px, 15vw, 95px);
  }

  .learning-intro {
    font-size: 18px;
  }

  .lesson-section,
  .concept-section,
  .flow-section,
  .security-section {
    padding: 85px 24px;
  }

  .lesson-content p {
    font-size: 18px;
  }

  .concept-grid,
  .steps,
  .learning-grid {
    grid-template-columns: 1fr;
  }

  /*
     Transaction flow becomes vertical on small screens.
     This prevents the alignment problem from returning.
  */
  .flow-grid {
    grid-template-columns: 1fr;
  }

  .flow-item {
    min-height: 190px;
  }

  .flow-arrow {
    min-height: 70px;
    border-right: 1px solid var(--border);
  }

  .flow-arrow::after {
    content: "↓";
  }

  .next-section {
    min-height: 500px;
    padding: 90px 24px;
  }

  .next-section h2 {
    font-size: clamp(60px, 14vw, 100px);
  }

  .site-footer {
    padding: 50px 24px;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-links {
    flex-wrap: wrap;
    gap: 20px;
  }

  .hero {
    padding: 80px 24px;
  }

  .hero h1 {
    font-size: clamp(60px, 14vw, 100px);
  }

  .hero-actions {
    flex-direction: column;
    align-items: flex-start;
  }

  .journey-track {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 500px) {
  .logo {
    font-size: 14px;
  }

  .nav-action {
    padding: 9px 11px;
  }

  .learning-hero h1 {
    font-size: 55px;
  }

  .concept-card,
  .step,
  .flow-item {
    padding: 27px 22px;
  }

  .flow-section h2 {
    font-size: 58px;
  }

  .lesson-header h2 {
    font-size: 48px;
  }
}

/* =========================================================
   ACCESSIBILITY
========================================================= */

:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 4px;
}

/* =========================================================
   LEARN HUB
========================================================= */

.learn-page {
  min-height: 100vh;
  background: #ffffff;
  color: #111111;
}

.learn-page .site-nav {
  background: #05060c;
  color: #ffffff;
}

.learn-page .logo {
  color: #ffffff;
  text-decoration: none;
}

.learn-page .nav-links a {
  color: #ffffff;
  text-decoration: none;
}

.learn-page .nav-action {
  color: #20e5ff;
  text-decoration: none;
}

.learn-page-content {
  max-width: 1400px;
  margin: 0 auto;
  padding: 110px 7vw;
}

.learn-page-content h1 {
  margin: 20px 0 30px;
  font-size: clamp(70px, 10vw, 150px);
  line-height: 0.85;
  letter-spacing: -0.06em;
  color: #111111;
}

.learn-page-content h1 span {
  color: #7c3cff;
}

.learn-page-content > p:last-of-type {
  max-width: 700px;
  margin-bottom: 80px;
  color: #555555;
  font-size: 22px;
  line-height: 1.6;
}

.learn-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid #d8d8d8;
  border-left: 1px solid #d8d8d8;
}

.learn-options a {
  min-height: 260px;
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 1px solid #d8d8d8;
  border-bottom: 1px solid #d8d8d8;
  color: #111111;
  text-decoration: none;
  transition: background 0.2s ease;
}

.learn-options a:hover {
  background: #f3f1ff;
}

.learn-options strong {
  font-size: 22px;
  letter-spacing: 0.04em;
}

.learn-options span {
  max-width: 400px;
  color: #666666;
  font-size: 20px;
  line-height: 1.5;
}

.learn-options b {
  color: #7c3cff;
  font-size: 14px;
  letter-spacing: 0.12em;
}

@media (max-width: 800px) {
  .learn-options {
    grid-template-columns: 1fr;
  }

  .learn-page-content {
    padding: 80px 24px;
  }
}


/* =========================================================
   CHAINLAB — PROFESSIONAL HOME
========================================================= */

.home-page {
  min-height: 100vh;
  background: #ffffff;
  color: #111111;
}

/* Intro */

.home-intro {
  min-height: 610px;
  padding: 90px 7vw 75px;
  border-bottom: 1px solid #dcdcdc;
  position: relative;
  overflow: hidden;
}

.home-intro::after {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -170px;
  top: 50px;
  border: 1px solid rgba(124, 60, 255, 0.2);
  border-radius: 50%;
  pointer-events: none;
}

.home-intro-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 45px;
}

.home-eyebrow {
  margin: 0;
  color: #743dff;
  font-family: "Space Mono", monospace;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.home-status {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #777777;
  font-family: "Space Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.1em;
}

.home-status i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #21b36b;
  display: inline-block;
  box-shadow: 0 0 10px rgba(33, 179, 107, 0.5);
}

.home-intro h1 {
  position: relative;
  z-index: 1;
  margin: 0;
  max-width: 950px;
  font-size: clamp(80px, 12vw, 175px);
  line-height: 0.82;
  letter-spacing: -0.065em;
  font-weight: 900;
}

.home-intro h1 span {
  color: #743dff;
}

.home-description {
  position: relative;
  z-index: 2;
  margin-top: 55px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
}

.home-description p {
  max-width: 600px;
  margin: 0;
  color: #666666;
  font-size: 21px;
  line-height: 1.55;
}

.home-cta {
  flex-shrink: 0;
  padding: 17px 24px;
  background: #743dff;
  color: #ffffff;
  text-decoration: none;
  font-family: "Space Mono", monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  transition: transform 0.2s ease, background 0.2s ease;
}

.home-cta span {
  margin-left: 15px;
  font-size: 16px;
}

.home-cta:hover {
  background: #5f28df;
  transform: translateY(-2px);
}

/* Learning areas */

.home-areas {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid #dcdcdc;
}

.home-area {
  min-height: 300px;
  padding: 35px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 1px solid #dcdcdc;
  color: #111111;
  text-decoration: none;
  transition: background 0.25s ease, color 0.25s ease;
}

.home-area:last-child {
  border-right: none;
}

.home-area:hover {
  background: #743dff;
  color: #ffffff;
}

.home-area-number {
  color: #743dff;
  font-family: "Space Mono", monospace;
  font-size: 13px;
  transition: color 0.25s ease;
}

.home-area:hover .home-area-number {
  color: #ffffff;
}

.home-area h2 {
  margin: 0 0 18px;
  font-size: 27px;
  letter-spacing: -0.03em;
}

.home-area p {
  max-width: 350px;
  margin: 0;
  color: #666666;
  font-size: 17px;
  line-height: 1.55;
  transition: color 0.25s ease;
}

.home-area:hover p {
  color: #eeeeee;
}

.home-area-arrow {
  align-self: flex-end;
  font-size: 25px;
}

/* Bottom signature */

.home-bottom {
  min-height: 100px;
  padding: 30px 7vw;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 30px;
  color: #888888;
  font-family: "Space Mono", monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.home-bottom strong {
  color: #111111;
  font-size: 11px;
}

.home-bottom span:last-child {
  text-align: right;
}

/* Mobile */

@media (max-width: 800px) {
  .home-intro {
    min-height: auto;
    padding: 70px 24px;
  }

  .home-intro-top {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
  }

  .home-intro h1 {
    font-size: clamp(65px, 18vw, 110px);
  }

  .home-description {
    align-items: flex-start;
    flex-direction: column;
  }

  .home-areas {
    grid-template-columns: 1fr;
  }

  .home-area {
    min-height: 240px;
    border-right: none;
    border-bottom: 1px solid #dcdcdc;
  }

  .home-bottom {
    grid-template-columns: 1fr;
    gap: 15px;
    padding: 30px 24px;
  }

  .home-bottom span:last-child {
    text-align: left;
  }
}


/* =========================================================
   CHAINLAB — WHITE WEB3 BACKGROUND
========================================================= */

.home-page {
  position: relative;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 72% 22%,
      rgba(124, 60, 255, 0.10),
      transparent 25%
    ),
    radial-gradient(
      circle at 18% 58%,
      rgba(32, 229, 255, 0.055),
      transparent 22%
    ),
    #fafafa;
}

/* Fine technical grid */

.home-page::before {
  content: "";
  position: absolute;
  inset: 0;

  pointer-events: none;

  background-image:
    linear-gradient(
      rgba(20, 20, 30, 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(20, 20, 30, 0.035) 1px,
      transparent 1px
    );

  background-size: 70px 70px;

  mask-image: linear-gradient(
    to bottom,
    black 0%,
    rgba(0, 0, 0, 0.55) 55%,
    transparent 100%
  );

  z-index: 0;
}

/* Large geometric Web3 orbit */

.home-page::after {
  content: "";

  position: absolute;

  width: 720px;
  height: 720px;

  right: -300px;
  top: 210px;

  border: 1px solid rgba(124, 60, 255, 0.16);
  border-radius: 50%;

  transform: rotate(-25deg);

  pointer-events: none;
  z-index: 0;
}

/* Keep actual content above the background */

.home-page > * {
  position: relative;
  z-index: 1;
}

/* Additional geometric rings */

.home-intro::before {
  content: "";

  position: absolute;

  width: 500px;
  height: 500px;

  right: 50px;
  top: 80px;

  border: 1px solid rgba(124, 60, 255, 0.10);
  border-radius: 50%;

  box-shadow:
    0 0 0 70px rgba(124, 60, 255, 0.025),
    0 0 0 140px rgba(124, 60, 255, 0.018);

  pointer-events: none;
}

/* Small technical nodes */

.home-intro::after {
  content: "◆     ·             ◇          ·";

  position: absolute;

  right: 110px;
  top: 270px;

  color: rgba(124, 60, 255, 0.30);

  font-size: 18px;
  letter-spacing: 45px;

  pointer-events: none;
}

/* Make the main heading sit cleanly above the graphics */

.home-intro h1,
.home-description,
.home-intro-top {
  position: relative;
  z-index: 2;
}

/* Subtle hover interaction */

.home-area {
  position: relative;
  overflow: hidden;
}

.home-area::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  right: -90px;
  bottom: -90px;

  border: 1px solid rgba(124, 60, 255, 0.12);
  border-radius: 50%;

  transition: transform 0.4s ease;
}

.home-area:hover::after {
  transform: scale(1.5);
}


